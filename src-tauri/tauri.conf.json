{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeamMP Host",
  "version": "0.1.0",
  "identifier": "com.beammp.host",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run export"
  },
  "app": {
    "windows": [
      {
        "title": "BeamMP Host",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "BeamMP Host"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 BeamMP Host",
    "category": "Utility",
    "shortDescription": "BeamMP server hosting with playit.gg tunnel",
    "longDescription": "Host a BeamMP dedicated server on your own PC and expose it to the internet through a playit.gg tunnel — all from a single desktop GUI."
  }
}
